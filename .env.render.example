# Render API configuration for automated CI/CD environment sync & deploy
# Copy this file to .env.render and fill in your values.
#
# 1. RENDER_API_KEY:
#    Go to https://dashboard.render.com -> Account Settings -> API Keys -> Create API Key
RENDER_API_KEY=rnd_your_render_api_key_here

# 2. RENDER_SERVICE_ID:
#    Open your frontend service in the Render dashboard.
#    Find the Service ID in the URL: https://dashboard.render.com/static/srv-xxxxxxxxxxxx
#    Or in the service Settings tab -> Service Info.
RENDER_SERVICE_ID=srv-your_service_id_here

# 3. (Alternative) RENDER_DEPLOY_HOOK:
#    If you prefer using a deploy hook instead of an API key:
#    Go to Service Settings -> Deploy Hook -> Copy URL
# RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxxx?key=yyyyy
