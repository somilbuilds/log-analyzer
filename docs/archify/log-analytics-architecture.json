  "cards": [
    {
      "dot": "cyan",
      "title": "Live request path",
      "items": [
        "log_replayer.py writes JSON batches; streaming_job.py polls them in Spark or --mode local.",
        "Mongo collections: window_aggregates, bloom_stats, dgim_stats, fm_stats.",
        "dashboard/app.py auto-refreshes every 5 seconds via pymongo."
      ]
    },
    {
      "dot": "emerald",
      "title": "Batch and storage",
      "items": [
        "Optional Spark sink writes Parquet to hdfs://namenode:9000/user/spark/web_logs; Hive web_logs is an external table.",
        "MapReduce uploads raw CLF to HDFS and counts HTTP status codes.",
        "analysis.R reads MongoDB and writes traffic_timeseries.png and related plots."
      ]
    },
    {
      "dot": "amber",
      "title": "Auth and externals",
      "items": [
        "No application login, API keys, or MongoDB auth; Streamlit and mongod are open on localhost.",
        "Hive Metastore JDBC user hive is container-internal only.",
        "No third-party SaaS APIs; source is the local CLF file plus Docker images."
      ]
    }
  ]
